<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Happy Birthday puchkiii Ma'am 🎀</title>

  <style>
    :root {
      --bg-gradient: linear-gradient(135deg, #ffdde1 0%, #ee9ca7 50%, #ffc3a0 100%);
      --card-bg: rgba(255, 255, 255, 0.85);
      --accent: #ff3366;
      --accent-glow: #ff668c;
      --text-color: #4a2e2e;
      --font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background: var(--bg-gradient);
      color: var(--text-color);
      font-family: var(--font-family);
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 20px;
      min-height: 100vh;
      overflow-x: hidden;
      position: relative;
    }

    /* Falling Hearts Animation */
    .particle {
      position: fixed;
      top: -20px;
      font-size: 22px;
      user-select: none;
      pointer-events: none;
      z-index: 1;
      animation: fall 4.5s linear forwards;
    }

    @keyframes fall {
      to {
        transform: translateY(105vh) rotate(360deg);
        opacity: 0;
      }
    }

    /* Floating Side Stickers */
    .floating-sticker {
      position: fixed;
      z-index: 10;
      width: 70px;
      height: 70px;
      object-fit: cover;
      border-radius: 50%;
      border: 3px solid #ffffff;
      box-shadow: 0 10px 25px rgba(255, 51, 102, 0.35);
      pointer-events: none;
      animation: floatMotion 3s ease-in-out infinite alternate;
    }

    .st-left { top: 12%; left: 4%; animation-duration: 2.8s; }
    .st-right { bottom: 12%; right: 4%; animation-duration: 3.5s; }

    @keyframes floatMotion {
      0% { transform: translateY(0px) rotate(-8deg) scale(1); }
      100% { transform: translateY(-20px) rotate(10deg) scale(1.05); }
    }

    .section {
      width: 100%;
      max-width: 450px;
      margin-bottom: 40px;
      text-align: center;
      position: relative;
      z-index: 5;
    }

    /* ---------------- PAGE 1: TAP HERE SCREEN ---------------- */
    #tap-screen {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 85vh;
    }

    .tap-card {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(15px);
      border: 3px solid #ffffff;
      border-radius: 35px;
      padding: 45px 30px;
      cursor: pointer;
      box-shadow: 0 20px 40px rgba(255, 51, 102, 0.3);
      transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      position: relative;
    }

    .sticker-container {
      position: relative;
      display: inline-block;
      margin-bottom: 20px;
    }

    .sticker-container::before {
      content: '';
      position: absolute;
      top: -10px; left: -10px; right: -10px; bottom: -10px;
      background: linear-gradient(45deg, #ff3366, #ff80ab, #ff3366);
      border-radius: 50%;
      z-index: -1;
      filter: blur(12px);
      animation: glowPulse 2s linear infinite;
    }

    @keyframes glowPulse {
      0%, 100% { opacity: 0.8; transform: scale(0.98); }
      50% { opacity: 1; transform: scale(1.05); }
    }

    .hero-img {
      width: 140px;
      height: 140px;
      object-fit: cover;
      border-radius: 50%;
      border: 4px solid white;
      box-shadow: 0 8px 20px rgba(0,0,0,0.15);
    }

    .tap-btn {
      background: linear-gradient(45deg, #ff3366, #ff668c);
      color: white;
      border: none;
      padding: 16px 36px;
      border-radius: 35px;
      font-size: 16px;
      font-weight: bold;
      letter-spacing: 1.5px;
      margin-top: 20px;
      cursor: pointer;
      box-shadow: 0 8px 25px rgba(255, 51, 102, 0.45);
      animation: pulseBtn 1.6s infinite;
    }

    @keyframes pulseBtn {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.06); }
    }

    /* ---------------- PAGE 2: MAIN CONTENT SCREEN ---------------- */
    #main-content {
      display: none;
      animation: zoomIn 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    }

    @keyframes zoomIn {
      from { opacity: 0; transform: scale(0.8) translateY(50px); }
      to { opacity: 1; transform: scale(1) translateY(0); }
    }

    .badge {
      background: linear-gradient(45deg, #ff3366, #ff668c);
      color: white;
      padding: 8px 22px;
      border-radius: 25px;
      font-size: 12px;
      font-weight: bold;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin-bottom: 15px;
      display: inline-block;
      box-shadow: 0 4px 15px rgba(255, 51, 102, 0.35);
    }

    .main-card {
      background: var(--card-bg);
      backdrop-filter: blur(12px);
      border-radius: 30px;
      padding: 30px 25px;
      box-shadow: 0 15px 35px rgba(0,0,0,0.08);
      margin-bottom: 30px;
      border: 1px solid rgba(255,255,255,0.8);
    }

    .title-tagda {
      font-size: 32px;
      font-weight: 800;
      color: #ff3366;
      text-shadow: 2px 2px 10px rgba(255, 51, 102, 0.25);
      margin-top: 10px;
      margin-bottom: 5px;
      line-height: 1.2;
    }

    .subtitle-cute {
      font-size: 20px;
      color: #772b3d;
      margin-bottom: 15px;
      font-weight: 600;
    }

    .wishes-text {
      font-size: 14px;
      line-height: 1.7;
      margin: 15px 0;
      color: #555;
    }

    /* Music Player */
    .music-player {
      background: rgba(255, 230, 235, 0.9);
      border-radius: 20px;
      padding: 14px 22px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin: 20px 0;
      border: 1px solid #ffb3c1;
    }

    .play-btn {
      background: var(--accent);
      color: white;
      border: none;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      cursor: pointer;
      font-size: 18px;
      box-shadow: 0 4px 12px rgba(255, 51, 102, 0.4);
    }

    /* Carousel */
    .carousel {
      background: white;
      border-radius: 20px;
      padding: 15px;
      box-shadow: 0 8px 20px rgba(0,0,0,0.05);
    }

    .carousel-img {
      width: 100%;
      height: 250px;
      object-fit: cover;
      border-radius: 15px;
    }

    .carousel-caption {
      font-size: 13px;
      margin-top: 12px;
      color: #666;
    }

    .carousel-nav {
      display: flex;
      justify-content: space-between;
      margin-top: 10px;
    }

    .nav-btn {
      background: #ffe5ec;
      border: 1px solid #ffb3c1;
      color: var(--accent);
      border-radius: 50%;
      width: 38px;
      height: 38px;
      cursor: pointer;
      font-weight: bold;
      font-size: 16px;
    }

    /* Bouquet Grid */
    .cards-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin-top: 15px;
    }

    .flower-card {
      background: white;
      border-radius: 16px;
      padding: 12px 5px;
      border: 2px solid #ffe0e3;
      cursor: pointer;
      min-height: 120px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-size: 11px;
      transition: all 0.3s;
    }

    .flower-card.revealed {
      background: #fff0f3;
      border-color: var(--accent);
      transform: scale(1.03);
    }

    .card-sticker-thumb {
      width: 40px;
      height: 40px;
      object-fit: cover;
      border-radius: 50%;
      margin-bottom: 6px;
    }

    .btn-action {
      background: linear-gradient(45deg, #ff3366, #ff668c);
      color: white;
      border: none;
      padding: 14px 30px;
      border-radius: 30px;
      font-weight: bold;
      cursor: pointer;
      margin-top: 15px;
      box-shadow: 0 6px 20px rgba(255, 51, 102, 0.35);
    }

    /* Modal */
    .modal {
      display: none;
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0, 0, 0, 0.55);
      backdrop-filter: blur(5px);
      align-items: center;
      justify-content: center;
      padding: 20px;
      z-index: 100;
    }

    .modal-content {
      background: white;
      border-radius: 25px;
      padding: 25px;
      max-width: 450px;
      max-height: 80vh;
      overflow-y: auto;
      text-align: left;
      position: relative;
      line-height: 1.7;
      font-size: 14px;
    }

    .close-modal {
      position: absolute;
      top: 15px;
      right: 15px;
      background: none;
      border: none;
      font-size: 24px;
      color: #aaa;
      cursor: pointer;
    }
  </style>
</head>
<body>

  <!-- Floating Side Stickers -->
  <img src="https://res.cloudinary.com/dtz0urit6/image/upload/q_auto:best,f_jpg/cloudinary-tools-uploads/mhmmvkja3qnuuz25q1w9" class="floating-sticker st-left" alt="Bear">
  <img src="https://res.cloudinary.com/dtz0urit6/image/upload/q_auto:best,f_jpg/cloudinary-tools-uploads/ghkzrqiy1zwsz2vfghcg" class="floating-sticker st-right" alt="Panda">

  <!-- ==================== PAGE 1 ==================== -->
  <div id="tap-screen" class="section">
    <div class="tap-card" onclick="openSurprise()">
      <div class="badge">✨ SPECIAL SURPRISE ✨</div>
      
      <div class="sticker-container">
        <img src="https://res.cloudinary.com/dtz0urit6/image/upload/q_auto:best,f_jpg/cloudinary-tools-uploads/oks8xrzxcajysgdrceti" class="hero-img" alt="Cake">
      </div>

      <div style="font-size: 40px; margin: 5px 0;">💌</div>
      
      <button class="tap-btn">TAP HERE ✨</button>
    </div>
  </div>

  <!-- ==================== PAGE 2 ==================== -->
  <div id="main-content" class="section">
    
    <div class="main-card">
      <div class="badge">🎀 FOR MY FAVOURITE 🎀</div>
      
      <h1 class="title-tagda">Happy Birthday</h1>
      <h2 class="subtitle-cute">puchkiii Ma'am 🎀</h2>

      <img src="https://res.cloudinary.com/dtz0urit6/image/upload/q_auto:best,f_jpg/cloudinary-tools-uploads/ghkzrqiy1zwsz2vfghcg" style="width: 110px; height: 110px; border-radius: 50%; object-fit: cover; margin: 12px 0; border: 4px solid #ffb3b9; box-shadow: 0 8px 20px rgba(255, 51, 102, 0.25);" alt="Panda">

      <p class="wishes-text">
        Today is all about you! A whole garden of wishes, for every laugh we've shared, every silly moment, and every reason you make the world brighter. HAPPY BIRTHDAY TO THE CUTEST PUCHKIII MA'AM! 🎀✨
      </p>

      <div class="music-player">
        <div style="text-align: left;">
          <div style="font-size: 13px; font-weight: bold;">Dedicated Music</div>
          <div style="font-size: 11px; color: #777;">CLICK TO PLAY ♡</div>
        </div>
        <button class="play-btn" onclick="toggleAudio()">▶</button>
        <audio id="bg-audio" loop>
          <source src="https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3" type="audio/mpeg">
        </audio>
      </div>

      <button class="btn-action" onclick="scrollToSection('album')">SEE OUR ALBUM ↓</button>
    </div>

    <div id="album" class="main-card">
      <div class="badge">♥ OUR ALBUM</div>
      <h2>Some cool album for you</h2>
      <p style="font-size: 12px; color: #888; margin-bottom: 15px;">a few of my favourite moments with you ♡</p>
      
      <div class="carousel">
        <img id="carousel-img" class="carousel-img" src="https://res.cloudinary.com/dtz0urit6/image/upload/q_auto:best,f_jpg/cloudinary-tools-uploads/oks8xrzxcajysgdrceti" alt="Memory">
        <div id="carousel-caption" class="carousel-caption">MEMORY 01 / 03: Cutting the sweet birthday cake together!</div>
        
        <div class="carousel-nav">
          <button class="nav-btn" onclick="prevSlide()">‹</button>
          <button class="nav-btn" onclick="nextSlide()">›</button>
        </div>
      </div>

      <button class="btn-action" onclick="scrollToSection('wishes')">PICK A WISH →</button>
    </div>

    <div id="wishes" class="main-card">
      <div class="badge">♥ THREE WISHES</div>
      <h2>a tiny bouquet of birthday wishes</h2>
      <p style="font-size: 12px; color: #888; margin-bottom: 15px;">pick each flower — there's a little wish inside ♡</p>

      <div class="cards-grid">
        <div class="flower-card" onclick="revealWish(this, '🌸 LAUGH', 'Your laugh makes every moment warmer.')">
          <img src="https://res.cloudinary.com/dtz0urit6/image/upload/q_auto:best,f_jpg/cloudinary-tools-uploads/ghkzrqiy1zwsz2vfghcg" class="card-sticker-thumb" alt="Panda">
          <div>PICK ME</div>
        </div>
        <div class="flower-card" onclick="revealWish(this, '🌼 CARE', 'Thank you for always being there.')">
          <img src="https://res.cloudinary.com/dtz0urit6/image/upload/q_auto:best,f_jpg/cloudinary-tools-uploads/mhmmvkja3qnuuz25q1w9" class="card-sticker-thumb" alt="Bear">
          <div>PICK ME</div>
        </div>
        <div class="flower-card" onclick="revealWish(this, '🌺 FUTURE', 'May this year bring you endless happiness.')">
          <img src="https://res.cloudinary.com/dtz0urit6/image/upload/q_auto:best,f_jpg/cloudinary-tools-uploads/oks8xrzxcajysgdrceti" class="card-sticker-thumb" alt="Cake">
          <div>PICK ME</div>
        </div>
      </div>

      <button class="btn-action" style="margin-top: 25px;" onclick="openLetter()">READ MY LETTER ✉️</button>
    </div>

  </div>

  <div id="letter-modal" class="modal">
    <div class="modal-content">
      <button class="close-modal" onclick="closeLetter()">×</button>
      <div style="text-align: center;">
        <img src="https://res.cloudinary.com/dtz0urit6/image/upload/q_auto:best,f_jpg/cloudinary-tools-uploads/mhmmvkja3qnuuz25q1w9" style="width:70px; height:70px; border-radius:50%; object-fit:cover; margin-bottom:10px;" alt="Bear">
        <div class="badge">♥ A LETTER JUST FOR YOU</div>
      </div>
      <h2 style="margin-top: 10px; text-align: center;">My puchkiii Ma'am 🎀,</h2>
      <p style="margin-top: 10px;">
        There's no card big enough for everything I'd like to say, so I made you a little garden — with a song, our pictures, and a few of my favourite wishes for the year ahead.
      </p>
      <br>
      <p>
        Thank you for the small and unseen things — the way you check in, the jokes only we get, and the quiet patience when I'm being too much. I noticed. I still notice.
      </p>
      <br>
      <p>
        I hope today you feel celebrated. Happy Birthday! ♡
      </p>
    </div>
  </div>

  <script>
    function createParticle() {
      const particle = document.createElement('div');
      particle.classList.add('particle');
      particle.innerText = ['💖', '✨', '🌸', '🎈', '🎀'][Math.floor(Math.random() * 5)];
      particle.style.left = Math.random() * 100 + 'vw';
      particle.style.animationDuration = Math.random() * 3 + 2.5 + 's';
      document.body.appendChild(particle);
      setTimeout(() => particle.remove(), 5000);
    }
    setInterval(createParticle, 350);

    function openSurprise() {
      document.getElementById('tap-screen').style.display = 'none';
      document.getElementById('main-content').style.display = 'block';
      try {
        toggleAudio();
      } catch(e) {}
    }

    const audio = document.getElementById('bg-audio');
    const playBtn = document.querySelector('.play-btn');

    function toggleAudio() {
      if (!audio) return;
      if (audio.paused) {
        let p = audio.play();
        if (p !== undefined) {
          p.then(() => { playBtn.innerText = '❚❚'; }).catch(() => { playBtn.innerText = '▶'; });
        }
      } else {
        audio.pause();
        playBtn.innerText = '▶';
      }
    }

    const slides = [
      { img: 'https://res.cloudinary.com/dtz0urit6/image/upload/q_auto:best,f_jpg/cloudinary-tools-uploads/oks8xrzxcajysgdrceti', caption: 'MEMORY 01 / 03: Cutting the sweet birthday cake together!' },
      { img: 'https://res.cloudinary.com/dtz0urit6/image/upload/q_auto:best,f_jpg/cloudinary-tools-uploads/ghkzrqiy1zwsz2vfghcg', caption: 'MEMORY 02 / 03: The cutest birthday princess puchkiii Ma\'am!' },
      { img: 'https://res.cloudinary.com/dtz0urit6/image/upload/q_auto:best,f_jpg/cloudinary-tools-uploads/mhmmvkja3qnuuz25q1w9', caption: 'MEMORY 03 / 03: A beautiful bouquet of flowers just for you!' }
    ];

    let currentSlide = 0;

    function updateSlide() {
      document.getElementById('carousel-img').src = slides[currentSlide].img;
      document.getElementById('carousel-caption').innerText = slides[currentSlide].caption;
    }

    function nextSlide() {
      currentSlide = (currentSlide + 1) % slides.length;
      updateSlide();
    }

    function prevSlide() {
      currentSlide = (currentSlide - 1 + slides.length) % slides.length;
      updateSlide();
    }

    function revealWish(element, title, text) {
      if (!element.classList.contains('revealed')) {
        element.classList.add('revealed');
        element.innerHTML = `<strong style="font-size:10px; color:var(--accent); margin-bottom:4px;">${title}</strong><span>${text}</span>`;
      }
    }

    function openLetter() {
      document.getElementById('letter-modal').style.display = 'flex';
    }

    function closeLetter() {
      document.getElementById('letter-modal').style.display = 'none';
    }

    function scrollToSection(id) {
      document.getElementById(id).scrollIntoView({ behavior: 'smooth' });
    }
  </script>
</body>
</html>